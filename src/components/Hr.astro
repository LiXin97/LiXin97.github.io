---
export interface Props {
  noPadding?: boolean;
  ariaHidden?: boolean;
  className?: string;
}

const { noPadding = false, ariaHidden = true, className = "" } = Astro.props;
---

<div class={`max-w-3xl mx-auto ${noPadding ? "my-4" : "my-8"}`}>
  <hr class={`border-skin-line ${className}`} aria-hidden={ariaHidden} />
</div>
