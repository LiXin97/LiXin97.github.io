---
export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  type?: "pubs" | "posts";
}

const { tag, tagName, size = "sm", type = "posts" } = Astro.props;
---

<li class="inline-block">
  <a
    href={`/${type}/tags/${tag}/`}
    transition:name={tag}
    class={`inline-flex items-center rounded-md px-2 py-0.5 
    ${size === "sm" ? "text-xs" : "text-sm"} 
    font-medium bg-skin-accent/10 text-skin-accent hover:bg-skin-accent/20 
    transition-colors duration-200 group`}
  >
    <svg 
      class={`${size === "sm" ? "w-2.5 h-2.5" : "w-3.5 h-3.5"} mr-0.5 group-hover:scale-110 transition-transform duration-200`}
      fill="currentColor" 
      viewBox="0 0 20 20"
    >
      <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
    </svg>
    <span>{tagName}</span>
  </a>
</li>

<style>
  a {
    @apply relative decoration-dashed hover:-top-0.5 hover:text-skin-accent focus-visible:p-1;
  }
  a svg {
    @apply -mr-5 h-5 w-5 scale-95 text-skin-base opacity-80 group-hover:fill-skin-accent;
  }
</style>
