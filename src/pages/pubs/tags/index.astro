---
import { getCollection } from "astro:content";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Tag from "@components/Tag.astro";
import getUniquePubTags from "@utils/getUniquePubTags";
import getSortedPubsYears from "@utils/getSortedPubsYears";
import { SITE } from "@config";

const pubs = await getCollection("pub");
const { pubs_sort, unique_years } = getSortedPubsYears(pubs);
let tags = getUniquePubTags(pubs_sort);
---

<Layout title={`Publication Tags | ${SITE.title}`} currentPage="pubs">
  <Header activeNav="pubs" />
  <Main pageTitle="Publication Tags" pageDesc="Browse all publications by topic">
    <div class="rounded-lg border border-skin-line p-6 bg-skin-fill">
      <div class="mb-4">
        <p class="text-skin-base mb-6">
          Click on a tag to see all publications in that category.
        </p>
      </div>
      
      <div class="flex flex-wrap gap-3">
        {tags.map(({ tag, tagName }) => (
          <div class="mb-2">
            <Tag tag={tag} tagName={tagName} size="lg" type="pubs"/>
            <span class="text-xs text-skin-base">
              {pubs_sort.filter(pub => pub.data.tags && pub.data.tags.includes(tagName)).length}
            </span>
          </div>
        ))}
      </div>
      
      <div class="mt-8 text-center">
        <a 
          href="/pubs/" 
          class="inline-flex items-center px-4 py-2 rounded-md bg-skin-accent/10 text-skin-accent hover:bg-skin-accent/20 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          Back to All Publications
        </a>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>
