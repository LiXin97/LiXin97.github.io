---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import getSortedPubs from "@utils/getSortedPubs";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import PubCard from "@components/PubCard";
import PubCardMini from "@components/PubCardMini";
import MiniPubSection from "@components/MiniPubSection";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE, SOCIALS } from "@config";

const posts = await getCollection("blog");
const pubs = await getCollection("pub");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);

const sortedPubs = getSortedPubs(pubs);
// const featuredPubs = sortedPubs.filter(({ data }) => data.authors[0].name === "Xin Li" || data.authors[0].name === "Xin Li*");
const featuredPubs = sortedPubs.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;

interface NewsItem {
  date: string;
  content: string;
  isHighlight?: boolean;
  link?: string;
}

const newsItems: NewsItem[] = [
  {
    date: "2025.03",
    content: "One paper accepted by ICLR 2025 ML4RS Workshop.",
    link: "https://ml-for-rs.github.io/iclr2025/",
  },
  {
    date: "2024.12",
    content:
      "Secured 4th place winner in the ICASSP 2025 Indoor Pathloss Radio Map Prediction Challenge.",
    link: "https://indoorradiomapchallenge.github.io/results.html",
  },
  {
    date: "2024.10",
    content: "Reached 100+ citations milestone on Google Scholar.",
    isHighlight: true,
    link: "https://scholar.google.com/citations?user=Hxf8sNkAAAAJ",
  },
  // {
  //   date: "2024.04",
  //   content: "Joined Nanyang Technological University as a Research Assistant.",
  //   // link: "https://www.ntu.edu.sg"
  // },
];

interface AwardItem {
  year: string;
  category: string;
  title: string;
  organization: string;
  link?: string;
}

const awardItems: AwardItem[] = [
  {
    year: "2025",
    category: "Scholarship",
    title: "Research Scholarship",
    organization: "Nanyang Technological University",
  },
  {
    year: "2024",
    category: "Conference",
    title: "4th Place winner",
    organization: "ICASSP 2025 Indoor Pathloss Radio Map Prediction Challenge",
    link: "https://indoorradiomapchallenge.github.io/results.html",
  },
];

interface ServiceItem {
  type: 'conference' | 'journal';
  name: string;
  years: string[];
  link?: string;
}

const serviceItems: ServiceItem[] = [
  // Conferences
  {
    type: 'conference',
    name: 'NeurIPS',
    years: ['2024', '2025'],
    link: 'https://neurips.cc/',
  },
  {
    type: 'conference',
    name: 'ICLR',
    years: ['2025'],
    link: 'https://iclr.cc/',
  },
  {
    type: 'conference',
    name: 'ICML',
    years: ['2025'],
    link: 'https://icml.cc/',
  },
  {
    type: 'conference',
    name: 'SIGGRAPH',
    years: ['2025'],
    link: 'https://www.siggraph.org/',
  },
  {
    type: 'conference',
    name: 'AISTATS',
    years: ['2025'],
    link: 'https://aistats.org/',
  },
  {
    type: 'conference',
    name: 'IROS',
    years: ['2021', '2022'],
    link: 'https://www.iros.org/',
  },
  {
    type: 'conference',
    name: 'ICRA',
    years: ['2022', '2023', '2025'],
    link: 'https://www.icra2023.org/',
  },
  // Journals
  {
    type: 'journal',
    name: 'IEEE RA-L',
    years: [],
    link: 'https://www.ieee-ras.org/publications/ra-l',
  },
  {
    type: 'journal',
    name: 'ACM Transactions on Graphics (TOG)',
    years: [],
    link: 'https://dl.acm.org/journal/tog',
  },
];

