---

<Layout currentPage="about">
  <Header />

  <main id="main-content" class="mx-auto px-4 sm:px-6 max-w-4xl transition-all duration-300 ease-in-out">
    <section id="hero" class="pb-8 pt-10">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-6 sm:text-5xl">Xin Li (李鑫)</h1>

      <img
        src="/images/XinLi.png"
        alt="Profile photo of Xin Li"
        itemprop="image"
        class="w-24 sm:w-32 md:w-40 border-2 border-skin-accent/20 rounded-full float-right shadow-lg transition-transform duration-300 hover:scale-105"
      />

      <p class="text-base font-medium">
        I am currently a first-year Ph.D. student at
        <!-- I currently work as a Research Assistant at -->
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="https://www.ntu.edu.sg/"
          >Nanyang Technological University (NTU)
        </LinkButton>, Singapore, under the supervision of
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="https://blogs.ntu.edu.sg/chau-yuen/"
          >Prof. Chau Yuen
        </LinkButton>.
      </p>
      <p class="text-base font-medium">
        I obtained my Master's degree from
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="http://english.pku.edu.cn"
          >Peking University
        </LinkButton> and Bachelor's degree from
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="https://www.neuq.edu.cn/"
          >Northeastern University (CN)
        </LinkButton>.
      </p>
      <!-- <p>
        I am passionate about developing algorithms that enable robots to
        understand the world around them.
      </p> -->

      <div class="my-6">
        <p class="flex items-center gap-2 text-lg">
          <svg class="w-5 h-5 text-skin-accent" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
          </svg>
        <a
          href="mailto:xin019@e.ntu.edu.sg"
            class="underline hover:text-skin-accent transition-colors"
        >
        xin019@e.ntu.edu.sg</a>
        </p>

      {
        // only display if at least one social link is enabled
        socialCount > 0 && (
            <div class="social-wrapper mt-4">
              <div class="social-links flex items-center gap-2">
                <svg class="w-5 h-5 text-skin-accent" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd" />
                </svg>
                Links:
              </div>
            <Socials />
          </div>
        )
      }

          <!-- Last Updated -->
          <div class="text-sm text-skin-base opacity-70 text-right">
            <p>
              <svg class="inline-block w-4 h-4 mr-1 -mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Last updated: {new Date().toLocaleDateString('en-US', {year: 'numeric', month: 'long', day: 'numeric'})}
            </p>
          </div>
      </div>
    </section>

    <Hr/>

    <section id="news" class="w-full">
        <h2 class="pb-6 pt-6 text-2xl font-semibold tracking-wide">News</h2>
      
      <div class="rounded-lg border border-skin-line p-4">
        <ul class="divide-y divide-skin-line">
          {
            newsItems.map((item) => (
              <li class="py-4 first:pt-0 last:pb-0 transition-colors hover:bg-skin-card/80">
                <div class="flex flex-col sm:flex-row gap-2">
                  <div class="sm:w-28 font-medium shrink-0">
                    {item.date}
                  </div>

                  <div class="flex-1">
                    <div class="flex items-start gap-1.5">
                      {item.isHighlight && (
                        <span class="inline-flex mt-0.5 items-center justify-center w-5 h-5 rounded-full bg-skin-accent/10 text-skin-accent flex-shrink-0">
                          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                          </svg>
                        </span>
                      )}
                      
                      <div class="flex flex-col">
                        <div class="flex items-center gap-2 mb-1">
                          
                        <span class="text-sm text-skin-base ">
                        {item.link ? (
                          <a
                            href={item.link}
                              class="hover:underline"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {item.content}
                          </a>
                        ) : (
                          item.content
                        )}
                      </span>
                          <span class="inline-flex items-center rounded-md bg-skin-accent/10 px-2 py-0.5 text-xs font-medium text-skin-accent">
                            {(() => {
                              // Return appropriate icon based on category
                              switch(item.category) {
                                case 'Publication':
                                  return (
                                    <svg class="mr-1 h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                      <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z" />
                                    </svg>
                                  );
                                case 'Award':
                                  return (
                                    <svg class="mr-1 h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                      <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z" />
                                    </svg>
                                  );
                                case 'Achievement':
                                  return (
                                    <svg class="mr-1 h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                  );
                                default:
                                  return (
                                    <svg class="mr-1 h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                                    </svg>
                                  );
                              }
                            })()}
                            {item.category}
                          </span>
                          
                        </div>
                      
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Hr />

    {
      featuredPubs.length > 0 && (
        <>
          <section id="pubs">
            <h2 class="pb-6 pt-6 text-2xl font-semibold tracking-wide">Selected Publications</h2>
            <p class="mb-4">
              Here are some of the papers I've published. Full list is available on{" "}
              <LinkButton
                className="underline hover:text-skin-accent"
                href="/pubs/"
              >
                Pubs
              </LinkButton>

              or 

              <a
                class="underline hover:text-skin-accent"
                href="https://scholar.google.com/citations?hl=en&user=Hxf8sNkAAAAJ"
              >
                Google Scholar
              </a>
              .<small>(* equal contribution)</small>
            </p>

            <div class="rounded-lg border border-skin-line p-4 bg-skin-fill">
              <ul class="divide-y divide-skin-line">
                {featuredPubs.map(({ data, slug }) => (
                      <div  class="py-4 first:pt-0 last:pb-0 transition-colors hover:bg-skin-card/80">
                        <PubCard client:visible href={`/pubs/${slug}/`} frontmatter={data} />
                      </div>
                ))}
              </ul>
            </div>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      (
        <>
          <section id="profession">
            <h2 class="pb-6 pt-6 text-2xl font-semibold tracking-wide">Education</h2>
            <div class="rounded-lg border border-skin-line p-4">
              <ul class="divide-y divide-skin-line">
                <li class="py-4 first:pt-0 transition-colors hover:bg-skin-card/80">
                  <div class="flex flex-col sm:flex-row gap-3">
                    <div class="sm:w-28 font-medium shrink-0">
                      2025.01 - Present
                    </div>
                    <div class="flex-1">
                      <div class="flex items-start gap-2">
                        <span class="inline-flex mt-0.5 items-center justify-center w-8 h-8 rounded-full bg-skin-accent/10 flex-shrink-0">
                          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z" />
                          </svg>
                        </span>
                        <div>
                          <h3 class="text-lg font-medium">Ph.D.</h3>
                          <p class="mb-1">
                            <a href="http://ntu.edu.sg" class="hover:underline">
                    Nanyang Technological University, Singapore
                            </a>
                          </p>
                          <p class="text-sm text-skin-base opacity-75 italic">
                            Supervisor: 
                            <a href="https://blogs.ntu.edu.sg/chau-yuen/" class="hover:underline">
                      Prof. Chau Yuen
                            </a>
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </li>
                
                <li class="py-4 transition-colors hover:bg-skin-card/80">
                  <div class="flex flex-col sm:flex-row gap-3">
                    <div class="sm:w-28 font-medium shrink-0">
                      2018.09 - 2021.07
                    </div>
                    <div class="flex-1">
                      <div class="flex items-start gap-2">
                        <span class="inline-flex mt-0.5 items-center justify-center w-8 h-8 rounded-full bg-skin-accent/10 flex-shrink-0">
                          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z" />
                          </svg>
                  </span>
                        <div>
                          <h3 class="text-lg font-medium">M.Eng.</h3>
                          <p class="mb-1">
                            <a href="http://english.pku.edu.cn" class="hover:underline">
                    Peking University
                            </a>
                          </p>
                          <p class="text-sm text-skin-base opacity-75 italic mb-1">
                            Supervisor: 
                            <a href="https://www.ss.pku.edu.cn/teacherteam/teacherlist/1652-%E6%9E%97%E9%87%91%E9%BE%99.html" class="hover:underline">
                              Prof. Jinlong Lin (林金龙)
                            </a>
                          </p>
                          <p class="text-sm text-skin-base opacity-75 italic">
                    Thesis:
                            <a href="/pubs/master_thesis/MatserThesis.pdf" class="hover:underline">
                              Multi-feature Simultaneous Localization and Mapping with coplanar constraints
                            </a>
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </li>
                
                <li class="py-4 last:pb-0 transition-colors hover:bg-skin-card/80">
                  <div class="flex flex-col sm:flex-row gap-3">
                    <div class="sm:w-28 font-medium shrink-0">
                      2014.09 - 2018.07
                    </div>
                    <div class="flex-1">
                      <div class="flex items-start gap-2">
                        <span class="inline-flex mt-0.5 items-center justify-center w-8 h-8 rounded-full bg-skin-accent/10 flex-shrink-0">
                          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z" />
                          </svg>
                  </span>
                        <div>
                          <h3 class="text-lg font-medium">B.Eng.</h3>
                          <p>
