---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import getSortedPubs from "@utils/getSortedPubs";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import PubCard from "@components/PubCard";
import PubCardMini from "@components/PubCardMini";
import MiniPubSection from "@components/MiniPubSection";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE, SOCIALS } from "@config";

const posts = await getCollection("blog");
const pubs = await getCollection("pub");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);

const sortedPubs = getSortedPubs(pubs);
// const featuredPubs = sortedPubs.filter(({ data }) => data.authors[0].name === "Xin Li" || data.authors[0].name === "Xin Li*");
const featuredPubs = sortedPubs.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;

interface NewsItem {
  date: string;
  content: string;
  isHighlight?: boolean;
  link?: string;
  category: string;
}

const newsItems: NewsItem[] = [
  {
    date: "2025.03",
    content: "One paper accepted by ICLR 2025 ML4RS Workshop.",
    link: "https://ml-for-rs.github.io/iclr2025/",
    category: "Publication"
  },
  {
    date: "2024.12",
    content:
      "Secured 4th place winner in the ICASSP 2025 Indoor Pathloss Radio Map Prediction Challenge.",
    link: "https://indoorradiomapchallenge.github.io/results.html",
    category: "Award"
  },
  {
    date: "2024.10",
    content: "Reached 100+ citations milestone on Google Scholar.",
    isHighlight: true,
    link: "https://scholar.google.com/citations?user=Hxf8sNkAAAAJ",
    category: "Achievement"
