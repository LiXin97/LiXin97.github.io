---

<Layout currentPage="about">
  <Header />

  <main id="main-content">
    <section id="hero">
      <h1>Xin Li (李鑫)</h1>

      <img
        src="/images/XinLi.png"
        alt="Profile photo of Xin Li"
        itemprop="image"
        style="width: 20%; border-radius: 50%; float: right;"
      />

      <p>
        I am currently a first-year Ph.D. student at
        <!-- I currently work as a Research Assistant at -->
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="https://www.ntu.edu.sg/"
          >Nanyang Technological University (NTU)
        </LinkButton>, Singapore, under the supervision of
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="https://blogs.ntu.edu.sg/chau-yuen/"
          >Prof. Chau Yuen
        </LinkButton>.
      </p>
      <p>
        I obtained my Master's degree from
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="http://english.pku.edu.cn"
          >Peking University
        </LinkButton> and Bachelor's degree from
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="https://www.neuq.edu.cn/"
          >Northeastern University (CN)
        </LinkButton>.
      </p>
      <!-- <p>
        I am passionate about developing algorithms that enable robots to
        understand the world around them.
      </p> -->

      <br />
      <p>
        Email:
        <a
          href="mailto:xin019@e.ntu.edu.sg"
          class="underline hover:text-skin-accent"
        >
        xin019@e.ntu.edu.sg</a>

        &nbsp;

        <!-- <a
          href="mailto:lixin.1997.lixin@gmail.com"
          class="underline hover:text-skin-accent"
        >
        lixin.1997.lixin@gmail.com</a> -->
      </p>


      {
        // only display if at least one social link is enabled
        socialCount > 0 && (
          <div class="social-wrapper">
            <div class="social-links">Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    <section id="news" class="w-full">
      <div class="mb-4 flex items-center gap-2">
        <h2 class="pb-6 pt-6 text-2xl font-semibold tracking-wide">News</h2>
        <!-- <span class="text-sm text-gray-500 pt-6">
          ({newsItems.length} updates)
        </span> -->
      </div>

      <div class="max-h-96 overflow-auto">
        <ul class="divide-y">
          {
            newsItems.map((item, index) => (
              <li
                class:list={[
                  "p-2 transition-colors",
                  // "p-4 hover:bg-gray-50 transition-colors",
                  // { "bg-gradient-to-r from-purple-50 to-transparent": item.isHighlight }
                ]}
              >
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
                  <div class="shrink-0 sm:w-32">
                    <span class="text-sm font-semibold">{item.date}</span>
                  </div>

                  <div class="flex-1">
                    <div class="flex flex-wrap items-start gap-2">
                      <span class="text-sm">
                        {item.isHighlight && "🎉 "}
                        {item.link ? (
                          <a
                            href={item.link}
                            class="hover:text-skin-accent"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {item.content}
                          </a>
                        ) : (
                          item.content
                        )}
                      </span>
                    </div>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Hr />

    {
      featuredPubs.length > 0 && (
        <>
          <section id="pubs">
            <h2>Selected Publications</h2>
            <p>
              Here are some of the papers I've published. Full list is available on{" "}
              <LinkButton
                className="underline hover:text-skin-accent"
                href="/pubs/"
              >
                Pubs
              </LinkButton>

              or 

              <a
                class="underline hover:text-skin-accent"
                href="https://scholar.google.com/citations?hl=en&user=Hxf8sNkAAAAJ"
              >
                Google Scholar
              </a>
              .<small>(* equal contribution)</small> <br />
            </p>

            {
              <ul max-h-96 overflow-auto class="divide-y">
                {featuredPubs.map(({ data, slug }) => (
                  <PubCard client:visible href={`/pubs/${slug}/`} frontmatter={data} />
                ))}
              </ul>
            }
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      (
        <>
          <section id="profession">
            <h2>Education</h2>
            <table style="width: 100%;">
              <tr>
                <th rowspan="2">Ph.D.</th>
                <td>
                  <LinkButton
                    className="underline hover:text-skin-accent"
                    href="http://ntu.edu.sg"
                  >
                    Nanyang Technological University, Singapore
                  </LinkButton>
                </td>
                <td>2025.01 - Present</td>
              </tr>
              <tr>
                <td colspan="3">
                  <span style="color: #888; font-style: italic; font-size: 0.8rem;">
                    Supervisor:{" "}
                    <LinkButton
                      className="underline hover:text-skin-accent"
                      href="https://blogs.ntu.edu.sg/chau-yuen/"
                    >
                      Prof. Chau Yuen
                    </LinkButton>
                  </span>
                </td>
              </tr>

              <tr>
                <td colspan="3">
                  <hr />
                </td>
              </tr>
              <tr>
                <th rowspan="3">M.Eng.</th>
                <td>
                  <LinkButton
                    className="underline hover:text-skin-accent"
                    href="http://english.pku.edu.cn"
                  >
                    Peking University
                  </LinkButton>
                </td>
                <td>2018.09 - 2021.07</td>
              </tr>
              <tr>
                <td colspan="3">
                  <span style="color: #888; font-style: italic; font-size: 0.8rem;">
                    Thesis:
                    <LinkButton
                      className="underline hover:text-skin-accent"
                      href="/pubs/master_thesis/MatserThesis.pdf"
                    >
                      Multi-feature Simultaneous Localization and Mapping with
                      coplanar constraints
                    </LinkButton>{" "}
                  </span>
                </td>
              </tr>
              <tr>
                <td colspan="3">
                  <span style="color: #888; font-style: italic; font-size: 0.8rem;">
                    Supervisor:{" "}
                    <LinkButton
                      className="underline hover:text-skin-accent"
                      href="https://www.ss.pku.edu.cn/teacherteam/teacherlist/1652-%E6%9E%97%E9%87%91%E9%BE%99.html"
                    >
                      Prof. Jinlong Lin (林金龙)
                    </LinkButton>
                  </span>
                </td>
              </tr>

              <tr>
                <td colspan="3">
                  <hr />
                </td>
              </tr>

              <tr>
                <th>B.Eng.</th>
                <td>
                  <LinkButton
                    className="underline hover:text-skin-accent"
                    href="https://www.neuq.edu.cn/"
                  >
                    Northeastern University (CN)
                  </LinkButton>
                </td>
                <td>2014.09 - 2018.07</td>
              </tr>
            </table>
          </section>
          <Hr />
        </>
      )
    }

    {
      (
        <>
          <section id="profession">
            <h2>Experience</h2>

            <table
              style="width: 100%; margin-right: auto; margin-left: auto;"
              border="1"
            >
              <tr>
                <th rowspan="3">Research Assistant</th>
                <td>Nanyang Technological University</td>
                <td>2024.04 - 2025.01</td>
              </tr>

              <tr>
                <td>SUTD, Singapore</td>
                <td>2021.09 - 2022.03</td>
              </tr>

              <tr>
                <td colspan="2">
                  <span style="color: #888; font-style: italic; font-size: 0.8rem;">
                    Supervised by{" "}
                    <LinkButton
                      className="underline hover:text-skin-accent"
                      href="https://blogs.ntu.edu.sg/chau-yuen/"
                    >
                      Prof. Chau Yuen
                    </LinkButton>
                  </span>
                </td>
              </tr>

              <tr>
                <td colspan="3">
                  <hr />
                </td>
              </tr>

              <tr>
                <th>SLAM Engineer</th>
                <td>Gaussian Robotics, Singapore</td>
                <td>2022.03 - 2024.03</td>
              </tr>

              <tr>
                <td colspan="3">
                  <hr />
                </td>
              </tr>

              <tr>
                <th rowspan="4">Research Intern</th>
                <td>Microsoft Research Asia, Beijing</td>
                <td>2020.09 - 2021.04</td>
              </tr>
              <tr>
                <td colspan="3">
                  <span style="color: #888; font-style: italic; font-size: 0.8rem;">
                    Supervised by{" "}
                    <LinkButton
                      className="underline hover:text-skin-accent"
                      href="https://xueyuhanlang.github.io/"
                    >
                      Dr. Yang Liu (刘洋)
                    </LinkButton>{" "}
                    and{" "}
                    <LinkButton
                      className="underline hover:text-skin-accent"
                      href="https://yizhongzhang1989.github.io/"
                    >
                      Dr. Yizhong Zhang (张译中)
                    </LinkButton>
                  </span>
                </td>
              </tr>
              <tr>
                <td>Megvii (a.k.a Face++), Beijing</td>
                <td>2019.05 - 2020.03</td>
              </tr>
              <tr>
                <td colspan="3">
                  <span style="color: #888; font-style: italic; font-size: 0.8rem;">
                    Supervised by{" "}
                    <LinkButton
                      className="underline hover:text-skin-accent"
                      href="https://scholar.google.com/citations?user=_0lKGnkAAAAJ&hl=en"
                    >
                      Dr. Yijia He (贺一家)
                    </LinkButton>{" "}
                  </span>
                </td>
              </tr>
            </table>
          </section>
          <Hr />
        </>
      )
    }

    {
      (
        <>
          <section id="profession">
            <h2>Academic Services</h2>

            <div class="space-y-6">
              <div>
                <h3 class="text-lg font-medium mb-2">Conference Reviewer</h3>
                <div class="flex flex-wrap gap-2">
                  {serviceItems
                    .filter(item => item.type === 'conference')
                    .map(item => (
                      <div class="inline-flex items-center px-3 py-1 rounded-md bg-skin-card border border-skin-line">
                        {item.link ? (
                          <a href={item.link} class="font-medium text-skin-accent hover:underline">
                            {item.name}
                          </a>
                        ) : (
                          <span class="font-medium">{item.name}</span>
                        )}
                        {item.years.length > 0 && (
                          <span class="ml-1 text-xs">
                            ({item.years.join(', ')})
                          </span>
                        )}
                      </div>
                    ))}
                </div>
              </div>

              <div>
                <h3 class="text-lg font-medium mb-2">Journal Reviewer</h3>
                <div class="flex flex-wrap gap-2">
                  {serviceItems
                    .filter(item => item.type === 'journal')
                    .map(item => (
                      <div class="inline-flex items-center px-3 py-1 rounded-md bg-skin-card border border-skin-line">
                        {item.link ? (
                          <a href={item.link} class="font-medium text-skin-accent hover:underline">
                            {item.name}
                          </a>
                        ) : (
                          <span class="font-medium">{item.name}</span>
                        )}
                        {item.years.length > 0 && (
                          <span class="ml-1 text-xs">
                            ({item.years.join(', ')})
                          </span>
                        )}
                      </div>
                    ))}
                </div>
              </div>
            </div>
          </section>
          <Hr />
        </>
      )
    }

        {
      (
        <>
          <section id="pubs">
            <h2>Awards</h2>
            <ul class="divide-y">
              {awardItems.map(item => (
                <li class="py-3">
                  <div class="flex flex-col sm:flex-row">
                    <div class="sm:w-32 font-medium">{item.year}</div>
                    <div class="flex-1">
                      <div class="flex items-center">
                        <span class="mr-2 inline-flex items-center rounded-md bg-skin-accent/10 px-2 py-1 text-xs font-medium text-skin-accent">
                          <svg class="mr-1 h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 1l2.928 6.39 6.84.678-5.11 4.808 1.553 6.813L10 16.865l-6.21 3.824 1.553-6.813-5.11-4.808 6.84-.678L10 1z" clip-rule="evenodd" />
                          </svg>
                          {item.category}
                        </span>
                        <span class="font-medium">{item.title}</span>
                      </div>
                      <p class="text-sm">
                        {item.link ? (
                          <a href={item.link} class="hover:text-skin-accent">
                            {item.organization}
                          </a>
                        ) : (
                          item.organization
                        )}
                      </p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </section>
          <Hr />
        </>
      )
    }
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Hero Section ===== */
  #hero {
    @apply pb-6 pt-8;
  }
  #hero h1 {
    @apply my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl;
  }
  #hero .rss-link {
    @apply mb-6;
  }
  #hero .rss-icon {
    @apply mb-2 h-6 w-6 scale-110 fill-skin-accent sm:mb-3 sm:scale-125;
  }
  #hero p {
    @apply my-2;
  }
  .social-wrapper {
    @apply mt-4 flex flex-col sm:flex-row sm:items-center;
  }
  .social-links {
    @apply mb-1 mr-2 whitespace-nowrap sm:mb-0;
  }

  /* ===== Featured & Recent Posts Sections ===== */
  #featured,
  #news h2,
  #pubs h2,
  #profession h2,
  #recent-posts {
    @apply pb-6 pt-6;
  }
  #news h2,
  #pubs h2,
  #profession h2,
  #featured h2,
  #recent-posts h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }
  td,
  th {
    text-align: left; /* Aligns text to the left */
  }
</style>
