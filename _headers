# Netlify Headers Configuration
# Note: This file is for Netlify deployment. GitHub Pages doesn't support custom headers.
# If migrating to Netlify, this file will be automatically used.

# Cache static assets for 1 year
/style.css
  Cache-Control: public, max-age=31536000, immutable
/script.js
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable
/data/*.pdf
  Cache-Control: public, max-age=2592000
/data/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/data/*.png
  Cache-Control: public, max-age=31536000, immutable

# Cache HTML for shorter period (1 hour) to allow updates
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Security headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: http:; connect-src 'self'
